{
  "name": "droooly-configurator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DROOOLY 3D wheel configurator. Builds to ../visualize/.",
  "scripts": {
    "catalog": "node ../tools/export-catalog.js",
    "dev": "vite",
    "prebuild": "npm run catalog",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@react-three/test-renderer": "^9.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
